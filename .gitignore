# Holds the database credentials AND the intake encryption key.
# Copy db-config.example.php to db-config.php on each install, then run
# `php tools/generate-key.php` once and paste the key in.
/db-config.php

# Queued leads, stored documents, and logs (contain sensitive client/PHI data)
/storage/queue/
/storage/documents/
/storage/logs/

