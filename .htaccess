# ==============================================================================
# Rewire With Kajal / Kaja Portal - Apache Server Configuration
# ==============================================================================

# Set default directory index
DirectoryIndex index.html index.php

# Prevent directory browsing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ------------------------------------------------------------------------------
# URL Rewriting & Clean Routes
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Server-side code and data are never fetched over HTTP.
    RewriteRule ^(includes|admin/includes|tools|storage|cron|database|\.git)(/|$) - [F,L]

    # .html pages sit at the root. PHP pages live in php/, but public URLs stay
    # flat (/intake.php?token=...), so bookmarks and already-emailed links work.
    RewriteRule ^(blogs|blog-detail|intake|intake-thank-you|dashboard)\.php$ php/$1.php [L,QSA]

    # Friendly page routes (matches vercel.json)
    RewriteRule ^about/?$ about.html [L,QSA]
    RewriteRule ^blogs/?$ php/blogs.php [L,QSA]
    RewriteRule ^appointment/?$ appointment.html [L,QSA]
    RewriteRule ^intake-form/?$ intake-form.html [L,QSA]
    RewriteRule ^admin/?$ admin/index.php [L,QSA]
</IfModule>

# ------------------------------------------------------------------------------
# Security & Access Restrictions
# ------------------------------------------------------------------------------
# Block direct web access to sensitive configuration, database schemas, and documentation
<FilesMatch "(schema\.sql|db-config\.php|db-config\.example\.php|\.md|\.yml|\.yaml|\.log|\.git|\.gemini|\.reticle)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Admin session cookie: not readable from JS, not sent cross-site, no fixation.
<IfModule mod_php.c>
    php_flag  session.cookie_httponly on
    php_flag  session.use_strict_mode on
    php_value session.cookie_samesite Lax
</IfModule>

# ------------------------------------------------------------------------------
# Security Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
